# ========================================
# HRMS Backend - Environment Configuration
# ========================================
# This file uses centralized API configuration (src/config/api.config.js)
# Environment is automatically detected - no manual switching needed!

# ========================================
# Server Configuration
# ========================================
NODE_ENV=development
PORT=5000

# Backend URL (Optional - auto-detected based on NODE_ENV)
# BACKEND_URL=https://hrms-backend-xbz8.onrender.com

# ========================================
# Database Configuration
# ========================================
# Main database for global data (companies, super admins, system configs)
# Tenant databases will be created automatically as: hrms_<company_name>
MONGODB_URI=mongodb+srv://hrms-demo:deoghar@hrms-demo.hvqdjf6.mongodb.net/hrms_global?retryWrites=true&w=majority

# ========================================
# JWT Configuration
# ========================================
JWT_SECRET=your_jwt_secret_here
# JWT_EXPIRES_IN=7d

# ========================================
# CORS Configuration (IMPORTANT FOR PRODUCTION!)
# ========================================
# For Render/Production deployment, you MUST set these:
FRONTEND_URL=https://hrms-frontend-blush.vercel.app
CORS_ORIGIN=https://hrms-frontend-blush.vercel.app
# 
# For multiple domains (comma-separated):
# CORS_ORIGIN=https://hrms-frontend-blush.vercel.app,https://custom-domain.com
# 
# Default origins by environment:
# - development: http://localhost:5173, http://localhost:3000
# - production: Uses FRONTEND_URL or CORS_ORIGIN from above

# AI Analysis Configuration - Using DeepSeek V3.1 (Free)
# Get your API key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-v3
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7

# Legacy OpenAI Configuration (commented out - using DeepSeek instead)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ========================================
# Email Configuration
# ========================================
# Option 1: Gmail SMTP (Recommended for development)
# For Gmail: Use your Gmail address and App Password (not regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password_here

# Option 2: Custom SMTP (Recommended for production - Render, AWS, etc.)
# Use this if Gmail SMTP is blocked by your hosting provider
# Popular SMTP services: SendGrid, Mailgun, AWS SES, Brevo (Sendinblue)
# Example for SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

# Example for Brevo (Sendinblue) - Free tier available:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_brevo_email
# SMTP_PASS=your_brevo_smtp_key

# ========================================
# Redis Configuration (Optional - for token blacklisting)
# ========================================
# Redis is used for JWT token blacklisting (logout, user deactivation)
# If not configured, tokens will remain valid until expiry
# For development: redis://localhost:6379
# For production: Use Redis Cloud, AWS ElastiCache, etc.
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password_here
# REDIS_DB=0

# ========================================
# Google Sheets Integration (Optional)
# ========================================
# For Google Sheets bulk upload feature
# Get credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/employees/google-sheets/callback

# ========================================
# AWS S3 Configuration (For Resume Uploads)
# ========================================
# Get credentials from AWS IAM Console
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1
AWS_S3_BUCKET=spc-resumes

# Note: S3 bucket must be created and configured with proper CORS permissions
# Resume files will be uploaded to S3 and accessed via signed URLs for security
